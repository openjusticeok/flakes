# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# Local directory for junk files
/local/

# Secrets directory for secrets
/secrets/

# Mac file that stores custom icon information
.DS_Store

# Data directory
# Ignore by default to avoid committing sensitive or large data files.
# Uncomment an exception below for a local non-sensitive file.
data/*
## Example exceptions
# Track one specific file directly in data/
#!data/input/reference/example.csv
# Unignore the directory itself
#!data/input/reference/
# Unignore everything inside that directory
#!data/input/reference/**

# Local rv R package library
rv/*
!rv/scripts/

# targets pipeline store
_targets/

# Quarto render artifacts
.quarto/
*_files/

# direnv local cache
.direnv/

# Environment files
.env

# SSL certs
ssl/
